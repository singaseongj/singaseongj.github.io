# Copy to .env and fill in your Groq API key
GROQ_API_KEY=groq_test_key_replace_me
GROQ_MODEL=llama3-8b-8192
# Optionally change the server port
PORT=8787

# Voice to Keys demo LLM configuration
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Stock dashboard providers
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
FMP_KEY=

# Reliability
GLOBAL_BUDGET_MS=90000
REQ_TIMEOUT_MS=8000
CIRCUIT_MAX_ERRORS=8
CACHE_TTL_MS=3600000
COOLOFF_MS=60000

# Pools
INCLUDE_ETFS=0
MIN_ADV_US=200000
MIN_ADV_KR=50000
MIN_PRICE_USD=2
MIN_PRICE_KRW=1000
